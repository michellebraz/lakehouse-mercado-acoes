{
  "name": "PL_Origem_Incremental",
  "properties": {
    "description": "Carga incremental orientada a metadados: lê a lista de tabelas em dbo.controle_watermark, copia de cada uma só o que mudou (updated_at) para o ADLS em Parquet e avança o watermark apenas após sucesso. Ao final, opcionalmente dispara o job do Databricks.",
    "activities": [
      {
        "name": "LkpTabelas",
        "description": "Lista as tabelas a carregar e o último valor carregado de cada uma (metadados).",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 2,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "AzureSqlSource",
            "sqlReaderQuery": "SELECT tabela, CONVERT(VARCHAR(27), ultimo_valor, 121) AS ultimo_valor FROM dbo.controle_watermark",
            "queryTimeout": "02:00:00"
          },
          "dataset": {
            "referenceName": "DS_AzureSql_Tabela",
            "type": "DatasetReference",
            "parameters": {
              "tabela": "controle_watermark"
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEachTabela",
        "description": "Processa as tabelas em paralelo (até 3 por vez).",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LkpTabelas",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LkpTabelas').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 3,
          "activities": [
            {
              "name": "LkpMax",
              "description": "Maior updated_at atual: fecha a janela da carga, para não perder linhas alteradas durante a cópia.",
              "type": "Lookup",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 2,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "SELECT CONVERT(VARCHAR(27), MAX(updated_at), 121) AS max_atual FROM dbo.@{item().tabela}",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00"
                },
                "dataset": {
                  "referenceName": "DS_AzureSql_Tabela",
                  "type": "DatasetReference",
                  "parameters": {
                    "tabela": {
                      "value": "@item().tabela",
                      "type": "Expression"
                    }
                  }
                },
                "firstRowOnly": true
              }
            },
            {
              "name": "CopyTabela",
              "description": "Copia só a janela (ultimo_valor, max_atual] para landing/<tabela>/<data>/ em Parquet.",
              "type": "Copy",
              "dependsOn": [
                {
                  "activity": "LkpMax",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.01:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "SELECT * FROM dbo.@{item().tabela} WHERE updated_at > '@{item().ultimo_valor}' AND updated_at <= '@{activity('LkpMax').output.firstRow.max_atual}'",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None"
                },
                "sink": {
                  "type": "ParquetSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "formatSettings": {
                    "type": "ParquetWriteSettings"
                  }
                },
                "enableStaging": false
              },
              "inputs": [
                {
                  "referenceName": "DS_AzureSql_Tabela",
                  "type": "DatasetReference",
                  "parameters": {
                    "tabela": {
                      "value": "@item().tabela",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "DS_ADLS_Parquet",
                  "type": "DatasetReference",
                  "parameters": {
                    "pasta": {
                      "value": "@{item().tabela}/@{formatDateTime(convertFromUtc(pipeline().TriggerTime,'E. South America Standard Time'),'yyyy-MM-dd')}",
                      "type": "Expression"
                    },
                    "arquivo": {
                      "value": "@{item().tabela}_@{formatDateTime(pipeline().TriggerTime,'yyyyMMddHHmmss')}.parquet",
                      "type": "Expression"
                    }
                  }
                }
              ]
            },
            {
              "name": "SpAtualizaWatermark",
              "description": "Só roda se a cópia deu certo: garante que nenhuma linha seja pulada.",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [
                {
                  "activity": "CopyTabela",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 2,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "linkedServiceName": {
                "referenceName": "LS_AzureSql_Mercado",
                "type": "LinkedServiceReference"
              },
              "typeProperties": {
                "storedProcedureName": "[dbo].[usp_atualiza_watermark]",
                "storedProcedureParameters": {
                  "tabela": {
                    "value": {
                      "value": "@item().tabela",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "novo": {
                    "value": {
                      "value": "@activity('LkpMax').output.firstRow.max_atual",
                      "type": "Expression"
                    },
                    "type": "String"
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "RunJobPregao",
        "description": "Dispara o job do Databricks pela API (run-now). Começa DESATIVADA: ative depois de preencher os parâmetros databricks_*.",
        "type": "WebActivity",
        "state": "Inactive",
        "onInactiveMarkAs": "Succeeded",
        "dependsOn": [
          {
            "activity": "ForEachTabela",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:05:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": true
        },
        "typeProperties": {
          "method": "POST",
          "url": {
            "value": "@{pipeline().parameters.databricks_url}/api/2.2/jobs/run-now",
            "type": "Expression"
          },
          "headers": {
            "Authorization": {
              "value": "@concat('Bearer ', pipeline().parameters.databricks_token)",
              "type": "Expression"
            },
            "Content-Type": "application/json"
          },
          "body": {
            "value": "{\"job_id\": @{pipeline().parameters.databricks_job_id}, \"job_parameters\": {\"data_ref\": \"@{formatDateTime(convertFromUtc(pipeline().TriggerTime,'E. South America Standard Time'),'yyyy-MM-dd')}\", \"dias\": \"1\"}}",
            "type": "Expression"
          }
        }
      }
    ],
    "parameters": {
      "databricks_url": {
        "type": "string",
        "defaultValue": "https://SEU-WORKSPACE.cloud.databricks.com"
      },
      "databricks_job_id": {
        "type": "string",
        "defaultValue": "0"
      },
      "databricks_token": {
        "type": "securestring",
        "defaultValue": ""
      }
    },
    "annotations": [
      "lakehouse-mercado-acoes"
    ]
  }
}